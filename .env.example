# Copy to .env for Supabase-connected development. Never add a service-role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Set to true only for a static UI preview. Demo OTP is 123456; no database writes occur.
VITE_STATIC_DATA_MODE=true

# Zoho Commerce OAuth (server only; never prefix these with VITE_)
ZOHO_CLIENT_ID=your-zoho-oauth-client-id
ZOHO_CLIENT_SECRET=your-zoho-oauth-client-secret
ZOHO_REDIRECT_URI=https://your-domain.example/api/zoho/callback
# Generate independent random secrets and keep them in the hosting provider's server-side secret store.
ZOHO_OAUTH_STATE_SECRET=replace-with-long-random-secret
ZOHO_TOKEN_ENCRYPTION_KEY=base64-encoded-32-byte-random-key
# Keep outbound customer, vendor, catalogue, and order writes disabled until write scopes have been consented to,
# product SKUs and Zoho tax configuration have been reconciled, and a controlled pilot passes.
ZOHO_WRITE_SYNC_ENABLED=false
# Vercel Cron bearer secret; configure the same secret in Vercel Production env.
CRON_SECRET=replace-with-independent-random-secret
# Server-only Supabase settings used for admin checks and trusted integration writes.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# Zoho Books webhook secret (12-50 letters/digits), the same value as in the Zoho Books webhook.
ZOHO_WEBHOOK_SECRET=replace-with-the-zoho-webhook-secret

# Non-Vercel hosting (Hostinger Node.js / VPS): build with `npm run build:node`, run `npm start`.
# The Node server listens on PORT (default 3000) and HOST.
# PORT=3000
