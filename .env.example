# Environment variables for Grain Bazar. Values are intentionally BLANK: hosting panels (Hostinger,
# Vercel) may import this file, and a placeholder that looks like a value would be saved as one.
# Fill every blank from the owner's private secrets file. Never commit real values.
# Full guide: docs/hosting-hostinger.md

# --- Public, needed at BUILD time (npm run build:node) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
# Must be false on the live site (true = demo data, no database).
VITE_STATIC_DATA_MODE=false

# --- Server only (never prefix these with VITE_) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Zoho OAuth app (api-console.zoho.in). Redirect URI: https://<your-domain>/api/zoho/callback
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=
# Random secrets. ZOHO_TOKEN_ENCRYPTION_KEY is base64 of 32 random bytes.
ZOHO_OAUTH_STATE_SECRET=
ZOHO_TOKEN_ENCRYPTION_KEY=
# 12-50 letters/digits; the same value as the Secret of the Zoho Books webhooks.
ZOHO_WEBHOOK_SECRET=
# Bearer secret for the scheduled call to /api/zoho/sync (Hostinger cron / Vercel cron).
CRON_SECRET=

# Optional. Leave unset so the switch in Admin -> Zoho decides; "false" stops all website -> Zoho sync.
# ZOHO_WRITE_SYNC_ENABLED=

# Non-Vercel hosting (Hostinger Node.js / VPS): build with `npm run build:node`, run `npm start`.
# The Node server listens on PORT (default 3000).
# PORT=3000
