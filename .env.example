# Copy to .env for Supabase-connected development. Never add a service-role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Set to true only for a static UI preview. Demo OTP is 123456; no database writes occur.
VITE_STATIC_DATA_MODE=true

# Zoho Commerce OAuth (server only; never prefix these with VITE_)
ZOHO_CLIENT_ID=your-zoho-oauth-client-id
ZOHO_CLIENT_SECRET=your-zoho-oauth-client-secret
ZOHO_REDIRECT_URI=https://your-domain.example/api/zoho/callback
# Generate independent random secrets and keep them in the hosting provider's server-side secret store.
ZOHO_OAUTH_STATE_SECRET=replace-with-long-random-secret
ZOHO_TOKEN_ENCRYPTION_KEY=base64-encoded-32-byte-random-key
# Server-only Supabase settings used for admin checks and trusted integration writes.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
